name: Gemini Agent Auto-Merge
on:
  issues:
    types: [opened, edited]
  issue_comment:
    types: [created, edited]

jobs:
  gemini-cli:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      pull-requests: write
      issues: write
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Run Gemini CLI
        id: gemini
        uses: google-github-actions/run-gemini-cli@v1
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          gemini-api-key: ${{ secrets.GEMINI_API_KEY }}
          
      - name: Auto-merge PR
        if: steps.gemini.outputs.pr-url != ''
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          gh pr merge ${{ steps.gemini.outputs.pr-url }} --auto --merge
